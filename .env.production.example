APP_NAME="Funeral Referral"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

# Hostname Caddy serves and gets a certificate for, e.g. 203-0-113-10.sslip.io
SERVER_NAME=api.example.com

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=funeral_referral
DB_USERNAME=funeral
DB_PASSWORD=

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Web app origin allowed by CORS (the Netlify URL)
FRONTEND_URL=https://your-site.netlify.app

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

CRAWLER_USER_AGENT="FuneralReferralBot/1.0 (+mailto:you@example.com)"
CRAWLER_DELAY_MS=1000
