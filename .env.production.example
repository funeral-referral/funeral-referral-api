APP_NAME="Funeral Referral"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

# Hostname Caddy serves and gets a certificate for, e.g. 203-0-113-10.sslip.io
SERVER_NAME=api.example.com

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=funeral_referral
DB_USERNAME=funeral
DB_PASSWORD=

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Web app origin allowed by CORS (the Netlify URL)
FRONTEND_URL=https://your-site.netlify.app

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

CRAWLER_USER_AGENT="FuneralReferralBot/1.0 (+mailto:you@example.com)"
CRAWLER_DELAY_MS=1000
CRAWLER_ROBOTS_AGENT=FuneralReferralBot

# OpenStreetMap (Overpass) is off: its public hosts disallow /api/ in robots.txt.
# Only enable it with OSM_OVERPASS_URL pointing at an endpoint that allows it.
CRAWLER_OSM_ENABLED=false

# The first crawl loads every home as "new"; changes before this time are hidden
# from the "changed this week" view unless the initial load is requested.
CRAWLER_BASELINE_UNTIL="2026-11-01 00:00:00"

# Outreach. Drafts are written by Claude when ANTHROPIC_API_KEY is set, and from
# built-in templates when it is empty or the call fails.
ANTHROPIC_API_KEY=
OUTREACH_MODEL=claude-sonnet-5-5

# Printed in every email. The postal address is required by CAN-SPAM:
# campaigns cannot be approved until it is set.
OUTREACH_SENDER_NAME="Your Name"
OUTREACH_SENDER_TITLE="Partnerships"
OUTREACH_COMPANY="Your Company"
OUTREACH_POSTAL_ADDRESS="1 Main Street, City, ST 00000"
OUTREACH_OFFER="One or two sentences on what the partnership is."
OUTREACH_DAILY_CAP=50

# Shared secret an inbound-email service sends in the X-Webhook-Secret header.
# With this empty, the reply webhook refuses everything.
OUTREACH_WEBHOOK_SECRET=

# Sandbox SMTP (for example Mailtrap). Nothing reaches a real inbox with these.
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="outreach@example.com"
MAIL_FROM_NAME="${APP_NAME}"
